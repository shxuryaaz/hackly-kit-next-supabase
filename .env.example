NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# set by hackly on every build: the app's key for hackly's ai helper. never commit a real one.
HACKLY_AI_URL=https://hackly-api.onrender.com/ai
HACKLY_AI_KEY=hk_your-key
# optional: your own OpenAI key. when set, lib/ai.ts talks to OpenAI directly and the hackly allowance is not used.
# OPENAI_API_KEY=
